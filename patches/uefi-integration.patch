diff --git a/Resources/Configs/caihong.toml b/Resources/Configs/caihong.toml
new file mode 100644
index 00000000..e44cd229
--- /dev/null
+++ b/Resources/Configs/caihong.toml
@@ -0,0 +1,40 @@
+#
+# Device Status
+#
+[status]
+model_count = 1
+
+#
+# Boot Shim Configs
+#
+[boot_shim]
+requires_kernel_header = true
+
+#
+# UEFI FD Configs
+#
+[uefi_fd]
+base = 0xA7100000
+# 3 MB (0x300000) is exactly full for the RELEASE build, and a DEBUG build needs
+# room for the extra debug strings / assertions, so give the FD 4 MB.
+size = 0x400000
+
+#
+# Android Boot Image Kernel Configs
+#
+[boot_image_kernel]
+kernel_compression = "gzip"
+append_dtb         = true
+
+#
+# Android Boot Image Configs
+#
+# NOTE: the device now runs Android 16 (GKI boot image header v4).  With the
+# pre-OTA Android 15 firmware the ABL accepted this legacy v0 image; the newer
+# ABL rejects it ("Failed to load/authenticate boot image" and an instant reset
+# on the boot partition).  Match the reference giulia port and emit a v4 header.
+#
+[boot_image]
+header_version = 4
+os_version     = "16.0.0"
+os_patch_level = "2026-07"
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa3..c16fe8c9 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,13 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // Preserve the Android bootloader's FDT pointer before platform code uses x0.
+  adr   x1, ASM_PFX (gSecEntryArg0)
+  str   x0, [x1]
+  // SecEntry invalidates the FD cache; commit this slot before that happens.
+  dc    cvac, x1
+  dsb   sy
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -61,3 +68,8 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  .align 3
+  .global ASM_PFX (gSecEntryArg0)
+ASM_PFX (gSecEntryArg0):
+  .quad 0
